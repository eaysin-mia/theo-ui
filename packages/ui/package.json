      "default": "./dist/components/filters/*.js"
    },
    "./components/gantt": {
      "types": "./dist/components/gantt/index.d.ts",
      "import": "./dist/components/gantt/index.js",
      "default": "./dist/components/gantt/index.js"
    },
    "./components/gantt/*": {
      "types": "./dist/components/gantt/*.d.ts",
      "import": "./dist/components/gantt/*.js",
      "default": "./dist/components/gantt/*.js"
    },
    "./components/qr-code": {
      "types": "./dist/components/qr-code/index.d.ts",
      "import": "./dist/components/qr-code/index.js",
      "default": "./dist/components/qr-code/index.js"
    },
    "./components/qr-code/*": {
      "types": "./dist/components/qr-code/*.d.ts",
      "import": "./dist/components/qr-code/*.js",
      "default": "./dist/components/qr-code/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    }
  },
  "peerDependencies": {
    "@better-auth-ui/core": ">=1.0.0",
    "@better-auth-ui/react": ">=1.0.0",
    "@headless-tree/core": ">=1.0.0",
    "@headless-tree/react": ">=1.0.0",
    "@tanstack/react-table": ">=8.0.0 || >=9.0.0",
