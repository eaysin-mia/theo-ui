{
  "name": "@workspace/ui",
  "version": "0.0.1",
  "description": "Accessible, unstyled-first UI component library built on Base UI and Tailwind CSS v4",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "COSS_SYNC.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "imports": {
    "#components/*": "./dist/components/*.js",
    "#patterns/*": "./dist/patterns/*.js",
    "#hooks/*": "./dist/hooks/*.js",
    "#lib/*": "./dist/lib/*.js",
    "#base-ui/*": "./dist/base-ui/*.js"
  },
  "scripts": {
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles/globals.css -o dist/styles.css --minify",
    "build": "pnpm build:js && pnpm build:css",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "pnpm build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "package:check": "publint"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./globals.css": "./dist/styles.css",
    "./theme.css": "./dist/styles.css",
    "./base-ui": {
      "types": "./dist/base-ui/index.d.ts",
      "import": "./dist/base-ui/index.js",
      "default": "./dist/base-ui/index.js"
    },
    "./base-ui/*": {
      "types": "./dist/base-ui/*.d.ts",
      "import": "./dist/base-ui/*.js",
      "default": "./dist/base-ui/*.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns/index.js",
      "default": "./dist/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./dist/patterns/*.d.ts",
      "import": "./dist/patterns/*.js",
      "default": "./dist/patterns/*.js"
    },
    "./lib": {
