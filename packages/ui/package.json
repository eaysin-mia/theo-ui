{
  "name": "@workspace/ui",
  "version": "0.0.1",
  "description": "Accessible, unstyled-first UI component library built on Base UI and Tailwind CSS v4",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "globals.css",
    "postcss.config.mjs",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib": "./src/lib/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./lib/highlighter": "./src/lib/highlighter.tsx",
    "./lib/auth": "./src/lib/auth/index.ts",
    "./lib/auth/*": "./src/lib/auth/*.ts",
    "./lib/auth/organization-plugin": "./src/lib/auth/organization-plugin.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./components/app-layout": "./src/components/app-layout/index.ts",
    "./components/app-layout/*": "./src/components/app-layout/*.tsx",
    "./components/auth": "./src/components/auth/index.ts",
    "./components/auth/*": "./src/components/auth/*.tsx",
    "./components/buttons": "./src/components/buttons/index.ts",
    "./components/buttons/*": "./src/components/buttons/*.tsx",
    "./components/event-calendar": "./src/components/event-calendar/index.ts",
    "./components/event-calendar/*": "./src/components/event-calendar/*.tsx",
    "./components/filters": "./src/components/filters/index.ts",
    "./components/filters/*": "./src/components/filters/*.tsx",
    "./components/gantt": "./src/components/gantt/index.ts",
    "./components/gantt/*": "./src/components/gantt/*.tsx",
    "./components/qr-code": "./src/components/qr-code/index.tsx",
    "./components/qr-code/*": "./src/components/qr-code/*.tsx",
    "./components/*": "./src/components/*.tsx"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth-ui/core": "^1.7.34",
    "@better-auth-ui/react": "^1.7.34",
    "@date-fns/tz": "^1.5.0",
    "@daypicker/react": "^10.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@headless-tree/core": "^1.8.0",
    "@headless-tree/react": "^1.8.0",
    "@paper-design/shaders-react": "^0.0.82",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.18",
    "bowser": "^2.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.66.0",
    "motion": "^14.14.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react-email": "^6.11.8",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@turbo/gen": "^2.11.10",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
