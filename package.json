{
  "name": "next-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build lint typecheck --filter=theoui && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
