{
  "name": "theoui",
  "version": "0.2.0",
  "description": "Accessible, unstyled-first UI component library built on Base UI and Tailwind CSS v4",
  "license": "MIT",
  "author": "Eaysin",
  "homepage": "https://github.com/eaysin-mia/theo-ui#readme",
  "bugs": {
    "url": "https://github.com/eaysin-mia/theo-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "base-ui",
    "tailwind",
    "framer-motion",
    "design-system"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eaysin-mia/theo-ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "imports": {
    "#components/*": "./dist/components/*.js",
    "#auth/*": "./dist/auth/*.js",
    "#hooks/*": "./dist/hooks/*.js",
    "#lib/*": "./dist/lib/*.js",
    "#/*": "./dist/*.js"
  },
  "scripts": {
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles/globals.css -o dist/styles.css --minify",
    "build": "pnpm build:js && pnpm build:css",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "pnpm build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:check": "publint"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./auth/*": {
      "types": "./dist/auth/*.d.ts",
      "import": "./dist/auth/*.js",
      "default": "./dist/auth/*.js"
    },
    "./auth/email": {
      "types": "./dist/auth/email/index.d.ts",
      "import": "./dist/auth/email/index.js",
      "default": "./dist/auth/email/index.js"
    },
    "./auth/email/*": {
      "types": "./dist/auth/email/*.d.ts",
      "import": "./dist/auth/email/*.js",
      "default": "./dist/auth/email/*.js"
    },
    "./auth/lib": {
      "types": "./dist/lib/auth/index.d.ts",
      "import": "./dist/lib/auth/index.js",
      "default": "./dist/lib/auth/index.js"
    },
    "./auth/lib/*": {
      "types": "./dist/lib/auth/*.d.ts",
      "import": "./dist/lib/auth/*.js",
      "default": "./dist/lib/auth/*.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "@better-auth-ui/core": ">=1.0.0",
    "@better-auth-ui/react": ">=1.0.0",
    "@headless-tree/core": ">=1.0.0",
    "@headless-tree/react": ">=1.0.0",
    "@tanstack/react-table": ">=8.0.0 || >=9.0.0",
    "better-auth": ">=1.0.0",
    "bowser": ">=2.15.0",
    "culori": ">=4.0.0",
    "motion": ">=11.0.0 || >=12.0.0 || >=14.0.0",
    "qrcode": ">=1.5.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "recharts": ">=2.0.0 || >=3.0.0",
    "shiki": ">=1.0.0 || >=3.0.0 || >=4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "better-auth": {
      "optional": true
    },
    "@better-auth-ui/core": {
      "optional": true
    },
    "@better-auth-ui/react": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "@headless-tree/core": {
      "optional": true
    },
    "@headless-tree/react": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "culori": {
      "optional": true
    },
    "bowser": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "^1.5.0",
    "@daypicker/react": "^10.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@paper-design/shaders-react": "^0.0.82",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-store": "^0.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.75.0",
    "motion": "^12.0.0 || ^14.0.0",
    "next-themes": "^0.4.6",
    "react-email": "^6.11.16",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@better-auth-ui/core": "^1.7.34",
    "@better-auth-ui/react": "^1.7.34",
    "@headless-tree/core": "^1.8.0",
    "@headless-tree/react": "^1.8.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-table": "^9.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@turbo/gen": "^2.11.12",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "better-auth": "^1.7.25",
    "bowser": "^2.15.0",
    "culori": "^4.0.2",
    "eslint": "^10",
    "jsdom": "^31.0.1",
    "motion": "^14.14.0",
    "publint": "^0.3.8",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
